pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Prasanth011/Flasky-app.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'sudo docker build -t flask-app .'
            }
        }

        stage('Deploy to EC2-2') {
            steps {
                sh '''
                scp -i /var/lib/jenkins/prasanth.pem -r . ubuntu@3.110.165.29:/home/ubuntu/flask-app

                ssh -i /var/lib/jenkins/prasanth.pem ubuntu@3.110.165.29 "
                    cd /home/ubuntu/flask-app &&
                    sudo docker build -t flask-app . &&
                    sudo docker stop flask-app || true &&
                    sudo docker rm flask-app || true &&
                    sudo docker run -d -p 5000:5000 flask-app
                "
                '''
            }
        }
    }
}

